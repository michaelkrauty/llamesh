[Unit]
Description=llamesh
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%REPO_PATH%
ExecStart=%REPO_PATH%/target/release/llamesh
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# Signal only llamesh, which drains in-flight requests and then stops its
# llama-server instances itself. The default KillMode=control-group signals
# every process of the service at once, so instances stop mid-request. Any
# process left when llamesh exits is still stopped by systemd.
KillMode=mixed
TimeoutStopSec=3600
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llamesh

[Install]
WantedBy=default.target
